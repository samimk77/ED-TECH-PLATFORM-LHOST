# ─── Dependencies ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment files (NEVER commit secrets) ───────────────
.env
.env.*
!.env.example        # allow the example template to be committed

# ─── Build outputs ──────────────────────────────────────────
dist/
build/
.vite/

# ─── Temp / upload files ────────────────────────────────────
tmp/
temp/
uploads/

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor artifacts ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Lock files (optional — keep if you want reproducible installs) ──
# package-lock.json
# yarn.lock

# ─── Misc ───────────────────────────────────────────────────
.cache/
*.local
